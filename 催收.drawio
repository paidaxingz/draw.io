        <mxCell id="PMpR4QO55q-T504xtksO-13" value="通用处理：&lt;div&gt;1.&lt;span style=&quot;color: rgb(86, 168, 245); font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: rgb(30, 31, 34);&quot;&gt;beforeReadFileTranProcess // 下载文件之前，删除临时表数据&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79)); background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212));&quot;&gt;Cbt_cust_info_tempDao.&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79)); background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); font-style: italic;&quot;&gt;delete_odb1&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(53, 159, 244);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79)); background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212));&quot;&gt;org_id, file_date&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(53, 159, 244);&quot;&gt;)//删除法人当天临时表数据&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(53, 159, 244);&quot;&gt;&lt;font color=&quot;#bcbec4&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;2.&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(86, 168, 245); font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: rgb(30, 31, 34);&quot;&gt;//读取每行供数文件数据时候的处理，写入临时表&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(86, 168, 245);&quot;&gt;bodyProcess&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(84, 168, 87);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(207, 142, 109);&quot;&gt;int &lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79));&quot;&gt;index, cbt_cust_info_temp mapping&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(84, 168, 87);&quot;&gt;) {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79));&quot;&gt;String org_id = runEnvs.getBusiOrgId&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(53, 159, 244);&quot;&gt;()&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79));&quot;&gt;;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79));&quot;&gt;&amp;nbsp; &amp;nbsp; String file_date = runEnvs.getTrxnDate&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(53, 159, 244);&quot;&gt;()&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79));&quot;&gt;;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;mapping.setFile_date&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(53, 159, 244);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79));&quot;&gt;file_date&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(53, 159, 244);&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79));&quot;&gt;;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;mapping.setOrg_id&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(53, 159, 244);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79));&quot;&gt;org_id&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(53, 159, 244);&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79));&quot;&gt;;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(207, 142, 109);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;return true&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: light-dark(rgb(188, 190, 196), rgb(73, 74, 79));&quot;&gt;;&amp;nbsp; // return 值决定是否执行自动入库操作，配置了mapping方可生效&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(73, 74, 79));&quot;&gt;3.&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(86, 168, 245); font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: rgb(30, 31, 34);&quot;&gt;afterReadFileTranProcess //读取文件完成后处理，更新供数文件导入状态&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; color: rgb(188, 190, 196); background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212));&quot;&gt;cbt_file_task_control.setDeal_status&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(53, 159, 244);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; color: rgb(188, 190, 196); background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212));&quot;&gt;E_FILE_DEAL_STATUS.&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(199, 125, 187); font-style: italic;&quot;&gt;INDATASUCC&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212)); color: rgb(53, 159, 244);&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; color: rgb(188, 190, 196); background-color: light-dark(rgb(30, 31, 34), rgb(209, 210, 212));&q